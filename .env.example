# Qloo hackathon key (https://hackathon.api.qloo.com). Required.
QLOO_API_KEY=
# OpenRouter key for the two small LLM calls per game (the plain-guess control and Q-Lou's line). Optional:
# without it Q-Lou writes its line from the facts and skips the control.
OPENROUTER_API_KEY=
# Optional
# CG_LLM_MODEL=google/gemini-3.5-flash-lite
# CG_LLM_DAILY_CAP=150
# CG_DATA_DIR=./data
# CG_REFRESH_CHECK_MINUTES=60   # the matrix keeper: extends from the outside list weekly, rebuilds monthly in the quiet hours; 0 turns it off
